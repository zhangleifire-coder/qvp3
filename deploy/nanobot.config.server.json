{
  "providers": {
    "deepseek_main": {
      "apiKey": "${DEEPSEEK_API_KEY}",
      "apiBase": "https://api.deepseek.com/v1"
    },
    "anthropic": {
      "apiKey": "${KIMI_API_KEY}",
      "apiBase": "https://api.kimi.com/coding"
    }
  },
  "modelPresets": {
    "qvp_main": {
      "provider": "deepseek_main",
      "model": "deepseek-v4-flash",
      "maxTokens": 8192,
      "contextWindowTokens": 131072,
      "temperature": 0.7
    },
    "qvp_fallback": {
      "provider": "anthropic",
      "model": "k3",
      "maxTokens": 8192,
      "contextWindowTokens": 131072
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "qvp_main",
      "fallbackModels": ["qvp_fallback"],
      "failOnToolError": false,
      "maxConcurrentSubagents": 1,
      "idleCompactAfterMinutes": 10
    }
  },
  "tools": {
    "mcpServers": {
      "qvp-tools": {
        "command": "python",
        "args": ["-m", "qvp_mcp"],
        "env": {
          "PYTHONPATH": "/app",
          "PYTHONUTF8": "1"
        },
        "toolTimeout": 1800000
      }
    }
  }
}
