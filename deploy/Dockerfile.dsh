# qvp3 应用镜像：后端 + dsh_serve(内嵌 dsh 子进程) + qvp_mcp 同容器（127.0.0.1 内部互联）
# Node 运行时从 Debian 版 node 镜像复制——必须与 python:3.12-slim 同为 glibc
# （node:*-alpine 是 musl libc，拷到 Debian 上无法运行，exit 127）
# 服务器本地化：docker save node:24-slim | ssh th@... docker load（Docker Hub 不通）
FROM node:24-slim AS node

FROM python:3.12-slim

ENV PYTHONUTF8=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

# Node 运行时（二进制 + 全局模块目录）
COPY --from=node /usr/local/bin /usr/local/bin
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

# dsh：版本钉死（开发者预览版有破坏性变更，升级需重跑 spike 验证清单）
# 值 = spike/serve 薄层实测版本，见 docs/dsh-spike-验证记录.md 与 dsh_serve/README.md
# npm 源可覆盖：--build-arg NPM_REGISTRY=https://registry.npmmirror.com（国内网络）
ARG DSH_VERSION=0.1.2-rc.1
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm install -g @deepseek-ai/dsh@${DSH_VERSION} --registry=${NPM_REGISTRY} && npm cache clean --force

WORKDIR /app

# 国内服务器走清华 PyPI 源（与旧栈一致，可 --build-arg 覆盖）
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 先装依赖层（代码变动不触发重装）
COPY requirements.txt .
RUN pip install -i ${PIP_INDEX_URL} -r requirements.txt

# dsh_serve 自身依赖（FastAPI/httpx 等已在主 requirements 中则幂等跳过）
COPY dsh_serve/requirements.txt dsh_serve/requirements.txt
RUN pip install -i ${PIP_INDEX_URL} -r dsh_serve/requirements.txt

# 代码 + 部署脚本（.env 由 compose env_file 运行时注入，不打进镜像）
COPY . .
RUN chmod +x deploy/entrypoint.dsh.sh && mkdir -p static/generated exports /data/dsh

# 海报 API 字体（src/api/posters_tmp.py 用）：
# - Noto Sans CJK（OFL，apt 官方源）：中文正文/标题，可分发
# - Remix Icon（Apache 2.0，npmmirror）：要点图标字体
# 本地开发可用 data/fonts/msyh*.ttc（微软雅黑，版权原因不入库/不分发，
# 渲染层自动回退到 Noto Sans CJK）。
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
RUN python - <<'EOF'
import httpx, tarfile, io, json, re
from pathlib import Path
r = httpx.get("https://registry.npmmirror.com/remixicon/-/remixicon-4.2.0.tgz",
              timeout=120, follow_redirects=True)
tf = tarfile.open(fileobj=io.BytesIO(r.content), mode="r:gz")
out = Path("/app/data/fonts"); out.mkdir(parents=True, exist_ok=True)
icon_map = {}
for m in tf.getmembers():
    if m.name.endswith("fonts/remixicon.ttf"):
        (out / "remixicon.ttf").write_bytes(tf.extractfile(m).read())
    if m.name.endswith("remixicon.css"):
        css = tf.extractfile(m).read().decode("utf-8")
        pat = re.compile(r'\.ri-([a-z0-9-]+):before\s*\{\s*content:\s*"\\([0-9a-f]{4})"')
        for name, code in pat.findall(css):
            icon_map[name] = int(code, 16)
(out / "remixicon_map.json").write_text(json.dumps(icon_map), encoding="utf-8")
assert (out / "remixicon.ttf").exists() and icon_map, "remixicon 字体下载失败"
print("poster fonts ready:", len(icon_map), "icons")
EOF

EXPOSE 8005
ENTRYPOINT ["deploy/entrypoint.dsh.sh"]
