# 数据库（本地专用 PG 容器可映射 5433；默认 5432）
DATABASE_URL=postgresql+asyncpg://qvp:qvp@localhost:5432/qvp
REDIS_URL=redis://localhost:6379/0

# 文本模型 Key（DeepSeek 主 / Kimi 备）
DEEPSEEK_API_KEY=sk-xxx
KIMI_API_KEY=sk-yyy

# 生图（OpenAI 兼容 Images API，含 /v1，经转发机）
OPENAI_IMAGE_BASE_URL=https://api.openox.net/v1
OPENAI_IMAGE_API_KEY=sk-xxx
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_SIZE=1152x1536
MOCK_IMAGE_GEN=false
IMAGE_GEN_DELAY_SECONDS=5

# 生图通道4 openox（备份通道，2026-09-08 接入；只确认支持文生图，
# 图生图请求轮到它时自动转给支持 edits 的其他通道）
OPENOX_API_KEY=                        # sk-... ；留空则该通道不进入轮询
OPENOX_BASE_URL=https://api.openox.net/v1

# OCR（阿里百炼，模型可换 qwen3.5-ocr / qwen3-vl-flash）
DASHSCOPE_API_KEY=sk-zzz
OCR_MODEL=qwen-vl-ocr
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 搜索（豆包搜索管证据包；OpenSERP 管搜实景图）
DOUBAO_SEARCH_KEY=sk-www
DOUBAO_ARK_KEY=sk-vvv
OPENSERP_BASE_URL=http://127.0.0.1:7001
DOUBAO_SEARCH_COST_PER_CALL=0.02
OPENSERP_COST_PER_CALL=0.02

# 并发（统计复用 AIMD）：起步/下限/上限
INITIAL_CONCURRENCY=2
MIN_CONCURRENCY=1
MAX_CONCURRENCY=4

# ── Nanobot 全链创作 Agent（2026-08-22 改造，详见 docs/改造说明-Nanobot全链Agent.md）──
AGENT_PIPELINE_ENABLED=true           # true=Agent 8节点路径 / false=原13节点直连（兜底回退开关）
NANOBOT_BASE_URL=http://127.0.0.1:8900/v1
NANOBOT_API_KEY=                      # 仅 bind 非 localhost 时需要
NANOBOT_MODEL=                        # 留空=用 nanobot 默认（qvp_main 预设）
NANOBOT_REQUEST_TIMEOUT_SECONDS=1800  # 全链一次 15-25 分钟，读超时给足
MCP_CALLBACK_BASE_URL=http://127.0.0.1:8003   # MCP 工具成本回调地址（后端）
INTERNAL_CALLBACK_TOKEN=qvp-internal-dev
MCP_MAX_IMAGES_PER_TASK=8             # 工具配额（防 Agent 失控烧钱的硬限制）
MCP_MAX_WEB_SEARCHES_PER_TASK=3
MCP_MAX_IMAGE_SEARCHES_PER_TASK=3
MCP_MAX_OCR_PER_TASK=8

# ── 审核角色权限口径 ──
ROLE_ALL_ACCESS=true                 # 试运行：任何账号可在审核台切换 A/B/C 任一角色；
                                     # 正式生产改 false，按账号角色锁定单一队列

# 系统配置
ENVIRONMENT=dev
LOG_LEVEL=INFO
HEARTBEAT_TIMEOUT_SECONDS=30
AUTO_SUSPEND_TIMEOUT_SECONDS=5400
SAMPLING_RATE=0.20
ANOMALY_MIN_SECONDS=5
ANOMALY_MAX_SECONDS=3600
IMAGE_GEN_PARALLEL=6                   # 任务内生图同批并发（fusionai 6 并发通道；1=串行防限流）
