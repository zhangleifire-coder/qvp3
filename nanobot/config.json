{
  "providers": {
    "deepseek_main": {
      "apiKey": "${DEEPSEEK_API_KEY}",
      "apiBase": "https://api.deepseek.com/v1"
    },
    "anthropic": {
      "apiKey": "${KIMI_API_KEY}",
      "apiBase": "https://api.kimi.com/coding"
    }
  },
  "modelPresets": {
    "qvp_main": {
      "provider": "deepseek_main",
      "model": "deepseek-v4-pro",
      "maxTokens": 8192,
      "contextWindowTokens": 131072,
      "temperature": 0.7
    },
    "qvp_fallback": {
      "provider": "anthropic",
      "model": "k3",
      "maxTokens": 8192,
      "contextWindowTokens": 131072
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "qvp_main",
      "fallbackModels": ["qvp_fallback"],
      "failOnToolError": false,
      "maxConcurrentSubagents": 1
    }
  },
  "tools": {
    "mcpServers": {
      "qvp-tools": {
        "command": "C:/Users/Zhang/iCloudDrive/Documents/安居-图文/2026-8-21-分支开发/图文生产平台_移交包_20260822/code/.venv/Scripts/python.exe",
        "args": ["-m", "qvp_mcp"],
        "env": {
          "PYTHONPATH": "C:/Users/Zhang/iCloudDrive/Documents/安居-图文/2026-8-21-分支开发/图文生产平台_移交包_20260822/code",
          "PYTHONUTF8": "1"
        },
        "toolTimeout": 1800000
      }
    }
  }
}
